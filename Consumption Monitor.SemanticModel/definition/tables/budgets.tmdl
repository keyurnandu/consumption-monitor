table budgets
	lineageTag: 2cc2dfa5-84db-4978-bc6c-a4d2ed561d6e

	measure '% Utilization by Budget Year' = ```
			
			
			VAR _consumption = 
			    CALCULATE(
			        SUM('usages'[quantity]),
			        FILTER(
			            ALL('usages'),
			            'usages'[application_id] IN VALUES('budgets'[application_id]) &&
			            'usages'[usage_date] >= SELECTEDVALUE('budgets'[validity_start_date]) &&
			            'usages'[usage_date] <= SELECTEDVALUE('budgets'[validity_end_date])
			        )
			    )
			
			VAR _budget = SELECTEDVALUE('budgets'[budget])
			
			RETURN
			    IF(
			        NOT ISBLANK(_budget),
			        1 - DIVIDE(_consumption, _budget),
			        BLANK()
			    )
			
			
			```
		formatString: 0%;-0%;0%
		lineageTag: 97f1e101-f08f-4b0f-8afe-093d4638584d

	measure 'YTD_Consumption by Budget Year' = ```
			
			VAR CurrentStart = CALCULATE(MAX('budgets'[validity_start_date]), budgets[bu_id])
			VAR CurrentEnd = CALCULATE(MAX('budgets'[validity_end_date]), budgets[bu_id])
			
			VAR PreviousStart = EDATE(CurrentStart, -12)
			
			VAR PreviousEnd = 
			    CALCULATE(
			        MAX('budgets'[validity_end_date]),
			        FILTER(
			            'budgets',
			            'budgets'[application_id] &&
			            'budgets'[validity_end_date] < CurrentStart
			        )
			    )
			
			RETURN 
			CALCULATE(
			    SUM('usages'[quantity]),
			    FILTER(
			        'usages',
			        'usages'[application_id] IN VALUES('budgets'[application_id] ) &&
			        'usages'[usage date (filter)] > PreviousStart &&
			        'usages'[usage date (filter)] <= COALESCE(PreviousEnd, CurrentStart)
			    )
			)
			
			```
		lineageTag: 358ffefd-d037-43ec-8f3c-359f0c38f42d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Burn / Month' =
			
			
			VAR MonthCount = DATEDIFF(STARTOFMONTH(budgets[validity_start_date]), STARTOFMONTH(budgets[validity_end_date]), MONTH)
			RETURN
			DIVIDE([YTD Consumption], MonthCount + 1, BLANK())
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: 8038b578-2133-443d-bf98-5c188747c106

	measure 'Usage Ratio' =
			
			VAR _application_id = SELECTEDVALUE('budgets'[application_id])
			VAR _bu_id = SELECTEDVALUE('budgets'[bu_id])
			VAR _start_date = SELECTEDVALUE('budgets'[validity_start_date])
			VAR _end_date = SELECTEDVALUE('budgets'[validity_end_date])
			VAR _budget = SELECTEDVALUE('budgets'[budget])
			
			VAR _consumption =
			    CALCULATE(
			        SUM('usages'[quantity]),
			        FILTER(
			            ALL('usages'),
			            'usages'[application_id] = _application_id &&
			            'usages'[bu_id] = _bu_id &&
			            'usages'[usage_date] >= _start_date &&
			            'usages'[usage_date] <= _end_date
			        )
			    )
			
			RETURN
			    IF(
			        NOT ISBLANK(_budget),
			        DIVIDE(_consumption, _budget),
			        BLANK()
			    )
		lineageTag: b1467d6e-75b3-4a65-b0cf-d66e0d5a34f5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Target Ratio' = ```
			
			VAR DateRange =       
			    CALCULATETABLE(      
			        VALUES(usages[usage_date]),      
			        ALLSELECTED(usages)      
			    )     
			VAR StartDate = MINX(DateRange, usages[usage_date])      
			VAR EndDate = MAXX(DateRange, usages[usage_date])   
			VAR MonthCount = DATEDIFF(StartDate, EndDate, MONTH) + 1
			
			VAR CurrentAverage = 
			CALCULATE(
			    SUM(usages[quantity]) 
			    , usages[bu_id] IN VALUES(usages[bu_id]), applications[application_id]
			    )
			    / MonthCount
			
			VAR TargetedAverage = 
			CALCULATE(    
			    SUM(budgets[budget])     
			    , usages[bu_id], usages[application_id]
			    ) 
			    / 12
			    
			RETURN
			IF(TargetedAverage <> 0,
			DIVIDE( CurrentAverage, TargetedAverage, 0))
			```
		lineageTag: f6c111be-9fde-44e6-a0c9-50ae7bfebca3

		annotation PBI_FormatHint = {"isGeneralNumber":true}

