	partition 'dates between start&end' = calculated
		mode: import
		source = ```
				
				GENERATE(
				    'budgets',
				    SELECTCOLUMNS(
				        FILTER(
				            'usages',
				            'usages'[application_id] = EARLIER('budgets'[application_id]) &&
				            'usages'[usage_date] >= EDATE('budgets'[validity_start_date], -12) &&
				            'usages'[usage_date] <= COALESCE(
				                CALCULATE(
				                    MAX('budgets'[validity_end_date]),
				                    FILTER(
				                        'budgets',
				                        'budgets'[application_id] = EARLIER('budgets'[application_id]) &&
				                        'budgets'[validity_end_date] < 'budgets'[validity_start_date]
				                    )
				                ),
				                'budgets'[validity_start_date]
				            )
				        ),
				        --"application_id", 'usages'[application_id],
				        "usage_date", 'usages'[usage_date],
				        "quantity", usages[quantity],
				        "service", usages[service],
				        "instance_id", usages[instance_id]
				    )
				)
				
				```

	annotation PBI_Id = ddfdb446cfbc40769707c705855ce833

