	column budget_id_1 =
			
			CALCULATE(
			    MAX('budgets'[budget_id]),
			    FILTER(
			        'budgets',
			        'budgets'[application_id] = 'usages'[application_id] &&
			        'budgets'[bu_id] = 'usages'[bu_id] &&
			        'usages'[usage_date] >= 'budgets'[validity_start_date] &&
			        'usages'[usage_date] <= 'budgets'[validity_end_date]
			    )
			)
		dataType: string
		lineageTag: cdc7721a-79b9-4c76-b5b9-9c74e29e67b5
		summarizeBy: none

		changedProperty = DataType

		annotation SummarizationSetBy = Automatic

