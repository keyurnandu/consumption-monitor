				    #"Added Custom" = Table.AddColumn(dbo_instances, "Datadog", each if [application_id] = 3 and Text.Contains([instance_name], "total") then 1 else 0),
				    #"Filtered Rows" = Table.SelectRows(#"Added Custom", each ([Datadog] = 0)),
