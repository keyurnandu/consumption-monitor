	partition instance = m
		mode: import
		source =
				let
				    Source = Sql.Databases("<YOUR_SQL_SERVER>,<PORT>"),
				    <YOUR_DATABASE> = Source{[Name="<YOUR_DATABASE>"]}[Data],
